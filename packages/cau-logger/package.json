{
  "name": "cau-logger",
  "version": "0.1.0",
  "description": "Fast, multi-transport logger built on Pino -- custom-agent-utils",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "knex": ">=3.0.0",
    "mongodb": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "knex": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "dotenv": "^16.4.5",
    "knex": "^3.1.0",
    "mongodb": "^7.1.0",
    "pg": "^8.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
