{
  "name": "@cloud-context-engine/client",
  "version": "0.1.0",
  "description": "TypeScript client for Cloud Context Surface API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "generate:types": "npx swagger-typescript-api generate -p ../docs/swagger.json -o src/generated -n api-types.ts --no-client --extract-request-params --extract-request-body --extract-response-body --extract-response-error",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ky": "^1.7.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^9.1.0",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "swagger-typescript-api": "^13.6.3",
    "tsup": "^8.3.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "minimatch": "5.1.8"
    },
    "rollup": "4.59.0"
  },
  "keywords": [
    "cloud-context-engine",
    "api-client",
    "typescript",
    "openapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-context-engine/apikey.git",
    "directory": "typescript-client"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
