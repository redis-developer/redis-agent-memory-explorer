            "redisIndices": [
              {
                "type": "tag"
              }
            ]
          },
          {
            "name": "description",
            "type": "str",
            "description": "Action item details",
            "redisIndices": [
              {
                "type": "text"
              }
            ]
          },
          {
            "name": "status",
