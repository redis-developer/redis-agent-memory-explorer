# ── Required ──
OPENAI_API_KEY=sk-your-openai-key-here

REDIS_URL=redis://your-cloud-redis-url:6379

# ── Redis Agent Memory (Cloud) ──
RAM_ENDPOINT=https://your-ram-endpoint.redis.io
RAM_API_KEY=your-ram-api-key
RAM_STORE_ID=your-store-id


# ── Context Surfaces ──
CTX_ADMIN_KEY=""
CTX_ADMIN_API_URL="https://cloud.redis.io/context-surfaces"
CTX_MCP_URL="https://gcp-us-east4.context-surfaces.redis.io/mcp"
CTX_SURFACE_ID=
MCP_AGENT_KEY=

# ── LangCache (optional, semantic cache for chatbot) ──
LANGCACHE_ENABLED=false
LANGCACHE_SERVER_URL=https://your-langcache-endpoint
LANGCACHE_CACHE_ID=your-cache-id
LANGCACHE_API_KEY=your-langcache-api-key
LANGCACHE_SIMILARITY_THRESHOLD=0.9
LANGCACHE_TTL_MILLIS=600000
LANGCACHE_NORMALIZE_MAX_TOKENS=256

# ── App (backend) ──
MEETING_MEMORY_PORT=3001
MEETING_MEMORY_ACTIVE_DATASET=wealth-advisor
MEETING_MEMORY_CONTEXT_WINDOW_MAX=1500
# Interactive path: chatbot agent + LangCache query normalizer.
MEETING_MEMORY_CHATBOT_MODEL=gpt-4o-mini
# Background path: suggestions, query extraction, memory summarization.
MEETING_MEMORY_BACKGROUND_MODEL=gpt-4o-mini

# ── LangSmith (optional) ──
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
