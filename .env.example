# ── Required ──
OPENAI_API_KEY=sk-your-openai-key-here

# ── App (backend) ──
# OPENAI_API_KEY defined above
MEETING_MEMORY_PORT=3001
MEETING_MEMORY_ACTIVE_DATASET=wealth-advisor
MEETING_MEMORY_MODEL_NAME=gpt-4o-mini
MEETING_MEMORY_CONTEXT_WINDOW_MAX=1500
MEETING_MEMORY_CHATBOT_MODEL=gpt-4o-mini

# ── Agent Memory Server ──
# OPENAI_API_KEY defined above
LONG_TERM_MEMORY=true
GENERATION_MODEL=gpt-4o-mini
FAST_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LOG_LEVEL=INFO

# ── LangSmith (optional) ──
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false


REDIS_URL=redis://...
RAM_STORE_ID="..."
RAM_ENDPOINT=https://gcp....redis.io
RAM_API_KEY=""
SUMMARY_MODEL=gpt-4o-mini
